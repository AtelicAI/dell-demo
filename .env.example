# Copy to .env and fill in. deploy/gen_env.sh generates every secret below except NVIDIA_API_KEY.
# Databases (internal to the compose network)
NEO4J_PASSWORD=
INFLUX_PASSWORD=
INFLUX_TOKEN=
POSTGRES_PASSWORD=
WORKFLOW_RUNTIME_PASSWORD=
QDRANT_API_KEY=
# Human engineer credential: held by the UI API, never sent to the browser or a model
ENGINEER_TOKEN=
ENGINEER_ID=demo-engineer
# NVIDIA hosted Nemotron (empty = agents fall back to the labelled deterministic template)
NVIDIA_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Web: ":8080" locally; a hostname (e.g. 1-2-3-4.sslip.io) on AWS for automatic HTTPS
SITE_ADDRESS=:8080
HTTP_PORT=8080
# Sign-in page (one shared demo login) and the key that signs session cookies
LOGIN_USER=atelic
LOGIN_PASSWORD=
SESSION_SECRET=
DEPLOYMENT_LABEL=Docker Compose (local)
